CHANNELS_WHATSAPP__ACCESS_TOKEN=...
CHANNELS_WHATSAPP__PHONE_NUMBER_ID=...
# Required: the server refuses to start without it
CHANNELS_WHATSAPP__WEBHOOK_SECRET=<your Meta app secret>
CHANNELS_WHATSAPP__VERIFY_TOKEN=<any string, also entered in the Meta dashboard>
# Sent as the X-API-Key header on every endpoint except the WhatsApp webhook; unset = all locked.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Set to false to run the webhook without loading the OCR engine (replies with a fixed message)
OCR_ENABLED=true
# OCR worker processes = receipts read in parallel; each holds its own copy of the models
OCR_WORKERS=4
# SQLite by default; e.g. postgresql+asyncpg://user:pass@host/db (needs asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./data/smaia.db
# Run `alembic upgrade head` on startup
DATABASE_MIGRATE_ON_STARTUP=true
# OCR engine: paddle | tesseract (Tesseract is CPU only)
OCR_ENGINE=paddle
# OCR device: auto (the GPU if there is one) | cpu | gpu:0
OCR_DEVICE=auto
