CHANNELS_WHATSAPP__ACCESS_TOKEN=...
CHANNELS_WHATSAPP__PHONE_NUMBER_ID=...
CHANNELS_WHATSAPP__WEBHOOK_SECRET=<your Meta app secret>
CHANNELS_WHATSAPP__VERIFY_TOKEN=<any string, also entered in the Meta dashboard>
# Set to false to run the webhook without loading PaddleOCR (replies with a fixed message)
OCR_ENABLED=true
# SQLite by default; e.g. postgresql+asyncpg://user:pass@host/db (needs asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./data/smaia.db
# Run `alembic upgrade head` on startup
DATABASE_MIGRATE_ON_STARTUP=true
